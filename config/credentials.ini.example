; Copy this file to config/credentials.ini and fill in what you need.
; config/credentials.ini is git-ignored: never commit your real keys.
;
; The HikerAPI key can also be pasted straight into the web UI, which writes
; it here for you - see doc/web-ui.md.

[Credentials]

; HikerAPI backend (recommended): your key from https://hikerapi.com
hikerapi_token =

; instagrapi backend (free, higher risk): an Instagram account of your own.
; Use a secondary account, never your main one. After filling these in, run
; `python scripts/instagrapi_login.py` once from a terminal.
username =
password =
; Optional proxy for instagrapi (HTTP/HTTPS/SOCKS5 / rotating residential proxy)
; e.g. http://user:pass@host:port or socks5://127.0.0.1:9050
proxy =

[AI]
; Local AI backend for AI mode in the web UI.
; Supported providers: lmstudio (default, OpenAI-compatible) or ollama.
; Can also be configured directly via the web UI (gear icon in the top bar).
provider = lmstudio
base_url = http://127.0.0.1:1234/v1
model = qwen3.5-4b
api_key =

[WebSearch]
; Optional opt-in public web context in AI mode (addresses #2699).
; Allows the AI model to query public web information about landmarks, venues, or events.
; Strictly privacy-guarded: personal usernames and Instagram handles are never sent.
; Providers: duckduckgo (default, zero-config), wikipedia, searxng (self-hosted), parallel
enabled = false
provider = duckduckgo
searxng_url = http://127.0.0.1:8080
parallel_api_key = 
